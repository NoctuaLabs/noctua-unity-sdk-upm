{
  "id": "starter_pack_extras",
  "engagement_type": "purchase",
  "auto_show": true,
  "priority": 70,
  "schema_version": 1,
  "data": {
    "bg": "https://cdn.example.com/extras/bg.png",
    "title": "STARTER PACK",
    "price": "$0.99",
    "product_id": "com.example.game.starter",
    "x_badge_text": "BEST VALUE",
    "store_price.com.example.game.bonus": "$1.99"
  },
  "i18n": {
    "id": {
      "x_badge_text": "PALING HEMAT"
    }
  },
  "view": {
    "type": "container",
    "style": {
      "width": "300",
      "height": "500",
      "position": "relative",
      "overflow": "hidden",
      "border_radius": "16"
    },
    "children": [
      {
        "type": "image",
        "props": {
          "url": "{{bg}}",
          "scale_mode": "cover"
        },
        "style": {
          "position": "absolute",
          "top": "0",
          "left": "0",
          "right": "0",
          "bottom": "0"
        }
      },
      {
        "type": "text",
        "props": {
          "text": "{{title}}"
        },
        "style": {
          "position": "absolute",
          "left": "22",
          "top": "56",
          "color": "#FFFFFF",
          "font_size": "30",
          "font_weight": "bold"
        }
      },
      {
        "type": "button",
        "props": {
          "text": "Get for {{price}}"
        },
        "style": {
          "position": "absolute",
          "left": "22",
          "top": "404",
          "width": "256",
          "background_color": "#17C07B",
          "color": "#FFFFFF",
          "font_size": "18",
          "font_weight": "bold",
          "padding_top": "12",
          "padding_bottom": "12",
          "border_radius": "12"
        },
        "action": {
          "type": "purchase",
          "product_id": "{{product_id}}"
        }
      },
      {
        "type": "image",
        "props": {
          "url": "https://cdn.example.com/extras/ribbon.png",
          "scale_mode": "fit"
        },
        "style": {
          "position": "absolute",
          "top": "8",
          "right": "8",
          "width": "72",
          "height": "72"
        }
      },
      {
        "type": "text",
        "props": {
          "text": "{{x_badge_text}}"
        },
        "style": {
          "position": "absolute",
          "top": "110",
          "left": "22",
          "color": "#FFD54F",
          "font_size": "16",
          "font_weight": "bold"
        }
      },
      {
        "type": "button",
        "props": {
          "text": "{{store_price.com.example.game.bonus}}"
        },
        "style": {
          "position": "absolute",
          "left": "22",
          "top": "456",
          "width": "256",
          "background_color": "#3B82F6",
          "color": "#FFFFFF",
          "font_size": "14",
          "padding_top": "8",
          "padding_bottom": "8",
          "border_radius": "10"
        },
        "action": {
          "type": "purchase",
          "product_id": "com.example.game.bonus"
        }
      }
    ]
  },
  "borderless": true
}
