{
  "id": "custom_event_hub",
  "engagement_type": "event",
  "auto_show": false,
  "priority": 70,
  "schema_version": 2,
  "data": {
    "t_title": "EVENT HUB",
    "t_card1_title": "Weekend Tournament",
    "t_card1_sub": "Top 100 win gems",
    "t_hero_caption": "Season 4 is live",
    "t_claim": "Claim chest"
  },
  "i18n": {
    "id": {
      "t_title": "PUSAT ACARA",
      "t_card1_title": "Turnamen Akhir Pekan",
      "t_claim": "Klaim peti"
    }
  },
  "view": {
    "type": "container",
    "style": {
      "width": "300",
      "flex_direction": "column",
      "padding": "12"
    },
    "children": [
      {
        "type": "text",
        "props": {
          "text": "{{t_title}}"
        },
        "style": {
          "color": "#FFFFFF",
          "font_size": "22",
          "font_weight": "bold"
        }
      },
      {
        "type": "container",
        "style": {
          "flex_direction": "row",
          "align_items": "center",
          "padding": "12",
          "margin_top": "8",
          "background_color": "#2D3138",
          "border_radius": "12"
        },
        "action": {
          "type": "deeplink",
          "deeplink": "event/tournament"
        },
        "children": [
          {
            "type": "image",
            "props": {
              "url": "https://cdn.example.com/custom/tournament.png",
              "scale_mode": "cover"
            },
            "style": {
              "width": "48",
              "height": "48",
              "border_radius": "8"
            }
          },
          {
            "type": "container",
            "style": {
              "flex_grow": "1",
              "flex_direction": "column",
              "margin_left": "12"
            },
            "children": [
              {
                "type": "text",
                "props": {
                  "text": "{{t_card1_title}}"
                },
                "style": {
                  "color": "#EAEAEA",
                  "font_size": "16",
                  "font_weight": "bold"
                }
              },
              {
                "type": "text",
                "props": {
                  "text": "{{t_card1_sub}}"
                },
                "style": {
                  "color": "#A0A3A7",
                  "font_size": "13"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "container",
        "style": {
          "height": "140",
          "margin_top": "8",
          "border_radius": "12",
          "overflow": "hidden",
          "position": "relative"
        },
        "action": {
          "type": "deeplink",
          "deeplink": "mygame://season/4"
        },
        "children": [
          {
            "type": "image",
            "props": {
              "url": "https://cdn.example.com/custom/season4.png",
              "scale_mode": "cover"
            },
            "style": {
              "position": "absolute",
              "top": "0",
              "right": "0",
              "bottom": "0",
              "left": "0"
            }
          },
          {
            "type": "text",
            "props": {
              "text": "{{t_hero_caption}}"
            },
            "style": {
              "color": "#FFFFFF",
              "font_size": "18",
              "position": "absolute",
              "bottom": "12",
              "left": "12"
            }
          }
        ]
      },
      {
        "type": "progressbar",
        "props": {
          "value": "{{points}}",
          "max": "100",
          "title": "{{points}}/100",
          "bar_color": "#22C55E"
        },
        "style": {
          "margin_top": "12"
        }
      },
      {
        "type": "button",
        "props": {
          "text": "{{t_claim}}"
        },
        "style": {
          "margin_top": "8",
          "background_color": "#17A34A"
        },
        "action": {
          "type": "deeplink",
          "deeplink": "missions/milestone/100",
          "keep_open": true
        },
        "visible_if": {
          "all": [
            {
              "left": "{{points}}",
              "op": "gte",
              "right": "100"
            },
            {
              "left": "{{claimed}}",
              "op": "ne",
              "right": "true"
            }
          ]
        }
      }
    ]
  },
  "borderless": false,
  "frame_color": "#A85FF7",
  "player_data": {
    "points": "0",
    "claimed": "false"
  },
  "backdrop_color": "#0F172AD9"
}